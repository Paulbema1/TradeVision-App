<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Statut du Service -->
        <TextView
            android:id="@+id/tvServiceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● SERVICE ONLINE"
            android:textColor="@color/signal_buy"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Sélecteur d'Actifs Horizontaux -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/assetContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- CARTE PRINCIPALE DU SIGNAL -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/bg_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 1. ACTIF -->
                <TextView
                    android:id="@+id/tvAsset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EUR/USD"
                    android:textColor="@color/text_main"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- 2. SIGNAL (BUY / SELL / WAIT) -->
                <TextView
                    android:id="@+id/tvAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="32dp"
                    android:paddingVertical="8dp"
                    android:text="BUY"
                    android:textColor="@color/signal_buy"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <!-- 3 & 4. CONFIANCE ET SCORE SEPARÉS -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvConfidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Confiance : 84%"
                        android:textColor="@color/text_main"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="   |   "
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Score : 84 / 100"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- 5. TIMEFRAMES -->
                <TextView
                    android:id="@+id/tvTimeframes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Main : 1H   •   Confirmation : 4H"
                    android:textColor="@color/admin_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="@color/bg_border" />

                <!-- 6. NIVEAUX DU TRADE (ENTRY, SL, TP1, TP2, TP3, R:R) -->
                <LinearLayout
                    android:id="@+id/levelsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ENTRY"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:id="@+id/tvEntry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.15750"
                            android:textColor="@color/text_main"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="STOP LOSS"
                            android:textColor="@color/signal_sell" />
                        <TextView
                            android:id="@+id/tvSL"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.15450"
                            android:textColor="@color/signal_sell"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TAKE PROFIT 1"
                            android:textColor="@color/signal_buy" />
                        <TextView
                            android:id="@+id/tvTP1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.16100"
                            android:textColor="@color/signal_buy"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TAKE PROFIT 2"
                            android:textColor="@color/signal_buy" />
                        <TextView
                            android:id="@+id/tvTP2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.16400"
                            android:textColor="@color/signal_buy"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TAKE PROFIT 3"
                            android:textColor="@color/signal_buy" />
                        <TextView
                            android:id="@+id/tvTP3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.16800"
                            android:textColor="@color/signal_buy"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRR"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:text="Risk / Reward : 1 : 2.5"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- 7. BOUTON COPY LEVELS -->
                    <Button
                        android:id="@+id/btnCopy"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/admin_accent"
                        android:text="📋 COPY LEVELS"
                        android:textColor="@color/text_main"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="@color/bg_border" />

                <!-- 8. EXPLICATION DU SIGNAL (WHY THIS SIGNAL?) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WHY THIS SIGNAL?"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/bg_main"
                    android:padding="12dp"
                    android:text="🟢 Technical Analysis : Bullish\n🟢 SMC : Bullish Structure\n🟢 Multi-Timeframe : 1H + 4H aligned\n🟢 Momentum : Positive\n🟢 News : Market reaction confirms news\n🟢 AI Confirmation : Confirmed"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>