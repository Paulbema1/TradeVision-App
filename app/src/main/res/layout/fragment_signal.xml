<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 🧪 BANDEAU D'AVERTISSEMENT MODE TEST LAB -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTestBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/signal_wait"
            app:cardCornerRadius="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:gravity="center"
                android:text="🧪 MODE SIMULATION TEST LAB (MARCHÉ SIMULÉ)"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Statut du Service -->
        <TextView
            android:id="@+id/tvServiceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● SERVICE ONLINE"
            android:textColor="@color/signal_buy"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Sélecteur d'Actifs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/assetContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- CARTE PRINCIPALE -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/bg_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvAsset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EUR/USD"
                    android:textColor="@color/text_main"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="32dp"
                    android:paddingVertical="8dp"
                    android:text="BUY"
                    android:textColor="@color/signal_buy"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvConfidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Confiance : 84%"
                        android:textColor="@color/text_main"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="   |   "
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Score : 84 / 100"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTimeframes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Main : 1H   •   Confirmation : 4H"
                    android:textColor="@color/admin_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="@color/bg_border" />

                <LinearLayout
                    android:id="@+id/levelsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ENTRY"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:id="@+id/tvEntry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.15750"
                            android:textColor="@color/text_main"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <ImageButton
                            android:id="@+id/btnCopyEntry"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Copy Entry"
                            android:src="@android:drawable/ic_menu_send"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="STOP LOSS"
                            android:textColor="@color/signal_sell" />
                        <TextView
                            android:id="@+id/tvSL"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.15450"
                            android:textColor="@color/signal_sell"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <ImageButton
                            android:id="@+id/btnCopySL"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Copy SL"
                            android:src="@android:drawable/ic_menu_send"
                            app:tint="@color/signal_sell" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TAKE PROFIT 1"
                            android:textColor="@color/signal_buy" />
                        <TextView
                            android:id="@+id/tvTP1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.16100"
                            android:textColor="@color/signal_buy"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <ImageButton
                            android:id="@+id/btnCopyTP1"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Copy TP1"
                            android:src="@android:drawable/ic_menu_send"
                            app:tint="@color/signal_buy" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TAKE PROFIT 2"
                            android:textColor="@color/signal_buy" />
                        <TextView
                            android:id="@+id/tvTP2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.16400"
                            android:textColor="@color/signal_buy"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <ImageButton
                            android:id="@+id/btnCopyTP2"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Copy TP2"
                            android:src="@android:drawable/ic_menu_send"
                            app:tint="@color/signal_buy" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TAKE PROFIT 3"
                            android:textColor="@color/signal_buy" />
                        <TextView
                            android:id="@+id/tvTP3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.16800"
                            android:textColor="@color/signal_buy"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <ImageButton
                            android:id="@+id/btnCopyTP3"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Copy TP3"
                            android:src="@android:drawable/ic_menu_send"
                            app:tint="@color/signal_buy" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRR"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:text="Risk / Reward : 1 : 2.5"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnCopy"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/admin_accent"
                        android:text="📋 COPY ALL LEVELS"
                        android:textColor="@color/text_main"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="@color/bg_border" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WHY THIS SIGNAL?"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/bg_main"
                    android:padding="12dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
